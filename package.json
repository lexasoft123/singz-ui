{
  "name": "@singz/ui",
  "version": "1.11.1",
  "description": "The night-studio design language — tokens and React components shared across SingZ and friends.",
  "author": "lexasoft <lexasoft@gmail.com>",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexasoft123/singz-ui.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js"
    },
    "./kit.css": "./dist/kit.css",
    "./tokens.css": "./dist/tokens.css",
    "./stems": {
      "types": "./dist/tokens/stems.d.ts",
      "import": "./dist/tokens/stems.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    },
    "./icon": {
      "types": "./dist/icon/glass.d.ts",
      "import": "./dist/icon/glass.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./native/icons": {
      "types": "./dist/icons/native.d.ts",
      "import": "./dist/icons/native.js"
    },
    "./banner": {
      "types": "./dist/primitives/Banner.d.ts",
      "import": "./dist/primitives/Banner.js"
    },
    "./meters": {
      "types": "./dist/meters/index.d.ts",
      "import": "./dist/meters/index.js"
    },
    "./native/meter": {
      "types": "./dist/native/meter.d.ts",
      "import": "./dist/native/meter.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "gen": "node scripts/gen-tokens.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/gen-tokens.mjs",
    "check": "node scripts/check-dist.mjs && node scripts/check-themeable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "themeable": "node scripts/check-themeable.mjs",
    "icons:native": "npm run build && node scripts/gen-native-icons.mjs && npm run build",
    "test:header": "npm run build && node --experimental-vm-modules --test scripts/native-header.test.mjs",
    "test": "npm run build && node --experimental-vm-modules --test scripts/*.test.mjs"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19",
    "react-native": ">=0.76",
    "@shopify/react-native-skia": ">=2",
    "react-native-reanimated": ">=4",
    "react-native-worklets": ">=0.5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "@shopify/react-native-skia": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shopify/react-native-skia": "^2.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.86.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-worklets": "^0.13.1",
    "typescript": "^5.8.3"
  }
}
