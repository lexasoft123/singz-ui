{
  "name": "@singz/ui",
  "version": "1.4.2",
  "description": "The night-studio design language \u2014 tokens and React components shared across SingZ and friends.",
  "author": "lexasoft <lexasoft@gmail.com>",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lexasoft123/singz-ui.git"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/tokens.d.ts",
      "import": "./dist/tokens/tokens.js"
    },
    "./kit.css": "./dist/kit.css",
    "./tokens.css": "./dist/tokens.css",
    "./stems": {
      "types": "./dist/tokens/stems.d.ts",
      "import": "./dist/tokens/stems.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    },
    "./icon": {
      "types": "./dist/icon/glass.d.ts",
      "import": "./dist/icon/glass.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "gen": "node scripts/gen-tokens.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/gen-tokens.mjs",
    "check": "node scripts/check-dist.mjs && node scripts/check-themeable.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "themeable": "node scripts/check-themeable.mjs"
  },
  "peerDependencies": {
    "react": "^18.3 || ^19",
    "react-dom": "^18.3 || ^19",
    "react-native": ">=0.76"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-native": "^0.86.0",
    "typescript": "^5.8.3"
  }
}
